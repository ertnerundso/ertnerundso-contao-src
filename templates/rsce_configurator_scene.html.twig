{% set isEnglish = app.request.pathInfo == '/en' or app.request.pathInfo starts with '/en/' %}
{% set defaultImageAlt = isEnglish ? 'Product configurator interface on a laptop.' : 'Oberfläche eines Produktkonfigurators auf einem Laptop.' %}
<section class="configurator-scene" aria-labelledby="configurator-scene-title">
    <div class="configurator-scene-sticky">
        <div class="configurator-scene-heading shell">
            <span class="micro">{{ eyebrow }}</span>
            <h2 id="configurator-scene-title">{{ sceneTitle }}</h2>
            <div class="configurator-scene-intro">
                <p><strong>{{ introLead }}</strong> {{ introText }}</p>
                <p>{{ detailText }}</p>
            </div>
        </div>
        <div class="configurator-scene-content shell">
            <div class="configurator-scene-media">
                <img class="configurator-scene-still" src="https://ertnerundso.github.io/ertnerundso-contao-src/assets/images/configurator-laptop-poster.jpg" width="1280" height="1024" alt="{{ imageAlt|default(defaultImageAlt)|e('html_attr') }}" loading="lazy" decoding="async">
                <video class="configurator-scene-video" muted playsinline preload="metadata" poster="https://ertnerundso.github.io/ertnerundso-contao-src/assets/images/configurator-laptop-start.jpg" aria-hidden="true" tabindex="-1">
                    <source src="https://ertnerundso.github.io/ertnerundso-contao-src/assets/videos/configurator-laptop.mp4" type="video/mp4">
                </video>
            </div>
            <div class="configurator-scene-cards">
                <div class="configurator-scene-card"><span class="micro">01</span><h3>{{ cardOneTitle }}</h3><p>{{ cardOneText }}</p><p>{{ cardOneDetail }}</p></div>
                <div class="configurator-scene-card"><span class="micro">02</span><h3>{{ cardTwoTitle }}</h3><p>{{ cardTwoText }}</p><p>{{ cardTwoDetail }}</p></div>
                <div class="configurator-scene-card"><span class="micro">03</span><h3>{{ cardThreeTitle }}</h3><p>{{ cardThreeText }}</p><p>{{ cardThreeDetail }}</p></div>
            </div>
        </div>
    </div>
</section>
