{% set articleText = text.invoke() %}

{% if archive.id in [3, 4] %}
    {% set isEnglish = archive.id == 4 %}
    {% set journalUrl = isEnglish ? '/en/journal/' : '/journal/' %}
    {% set contactUrl = isEnglish ? '/en/kontakt/' : '/kontakt/' %}
<article class="layout_full news-detail news-detail--journal{{ addImage|default(false) ? ' has-hero-image' : '' }} block" data-journal-article>
    <div class="news-detail-masthead">
        <a class="news-detail-back" href="{{ journalUrl }}"><span aria-hidden="true">←</span> {{ isEnglish ? 'Back to Journal' : 'Zurück zum Journal' }}</a>
        <span class="micro">{{ isEnglish ? 'JOURNAL / INSIGHT' : 'JOURNAL / EINBLICK' }}</span>
    </div>

    <div class="news-detail-body">
        {% if date|default('') %}
            <p class="news-detail-date micro"><time{% if datetime|default('') %} datetime="{{ datetime }}"{% endif %}>{{ datetime|default('') ? datetime|date('d.m.Y') : date }}</time></p>
        {% endif %}
        <div class="news-detail-hero">
            {% if addImage|default(false) %}
                {{ include('@Contao/image.html.twig') }}
            {% else %}
                <div class="journal-index-media-fallback" aria-hidden="true"><span>ERTNER&SO</span><strong>JOURNAL</strong></div>
            {% endif %}
        </div>
        {{ articleText|raw }}
    </div>

    <footer class="news-detail-outro journal">
        <div class="section-head">
          <div>
            <p class="micro">{{ isEnglish ? 'KEEP READING' : 'WEITERLESEN' }}</p>
            <h2>{{ isEnglish ? 'More perspectives on technology.' : 'Mehr Perspektiven auf Technik.' }}</h2>
          </div>
          <a class="text-link" href="{{ journalUrl }}">{{ isEnglish ? 'All articles' : 'Alle Artikel' }} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="journal-related" data-journal-related>
            {{ frontend_module('newslist', {
                news_archives: [archive.id],
                news_template: 'news_related_eo',
                cssID: ['', 'journal-list'],
                news_order: 'order_date_desc',
                numberOfItems: 7,
                perPage: 0
            }) }}
        </div>
        <div class="news-detail-actions">
            <a class="text-link" href="{{ contactUrl }}">{{ isEnglish ? 'Discuss a project' : 'Projekt besprechen' }} <span aria-hidden="true">↗</span></a>
        </div>
    </footer>
</article>
{% else %}
<div class="layout_full news-detail block">
    {{ articleText|raw }}
</div>
{% endif %}

{% set schemaOrg = getSchemaOrgData.invoke() %}
{% if hasText.invoke() %}
    {% set schemaOrg = schemaOrg|merge({text: articleText|html_to_plain_text}) %}
{% endif %}
{% do add_schema_org(schemaOrg) %}
