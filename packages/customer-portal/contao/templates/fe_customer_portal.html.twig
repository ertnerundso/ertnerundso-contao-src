{# Eigenes natives Seitenlayout: keine Marketing-Navigation und kein Tracking. #}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="{{ charset }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <base href="{{ base }}">
  <title>{{ title }}</title>
  {{ stylesheets|raw }}
  {{ head|raw }}
</head>
<body class="portal">
  <a class="skip-link" href="#portal-main">Zum Kundenportal</a>
  <main id="main">{{ main|raw }}</main>
  {{ mooScripts|raw }}
</body>
</html>
